# EmpirioLabs — runs Seedance 2.5 (video) and Seedream 5.0 Flash (avatar portraits)
# https://platform.empiriolabs.ai/dashboard/api-keys
EMPIRIOLABS_API_KEY=

# ElevenLabs — voice cloning, voice design and text-to-speech
# Instant Voice Cloning needs the Starter plan or higher
ELEVENLABS_API_KEY=

# Vercel Blob — stores portraits, voice samples, dialogue audio, avatars and job history.
# Create a Blob store in your Vercel project; this token is added automatically on Vercel.
BLOB_READ_WRITE_TOKEN=

# Crew password. Anyone opening the app is asked for it (any username works).
# Leave empty to disable the lock (not recommended once deployed).
APP_PASSWORD=

# Optional overrides
# SEEDANCE_MODEL=seedance-2-5
# IMAGE_MODEL=seedream-5-0-flash
# ELEVEN_TTS_MODEL=eleven_v3
